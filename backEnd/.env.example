X_RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com
URL=https://instagram-scraper-api2.p.rapidapi.com

# Comma-separated RapidAPI keys — tried left-to-right on rate-limit/failure
X_RAPIDAPI_KEYS=

# every RapidAPI key fails. No trailing slash — /profile/<username> is appended.
SCRAPPER_FALLBACK_URL=

DB=
PORT=8080
# Log level: DEBUG | INFO | NOTICE | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Bucket holding scraped profile pictures. Needs a CORS rule allowing GET from
# ALLOWED_ORIGIN: the roast card is rasterized in the browser, and an avatar
# served without CORS headers taints the canvas and kills the export.
BUCKET_NAME=instagram-profile-image
ALLOWED_LANGUAGE=english,hinglish,hindi,اردو,spanish,bangla,korean
ALLOWED_ORIGIN=http://localhost:5173,https://instaroasts.com
TOKEN_SECRET=

# Number of reverse-proxy hops in front of this process. Must match the actual
# deployment: too low and every visitor collapses to the proxy's IP, too high and
# clients can spoof their IP with a forged X-Forwarded-For header.
TRUST_PROXY_HOPS=1

# --- Monetization kill switches (per region) ---
# Turn either region off to make roasts unlimited and free there: no paywall, no
# session cookie, no DB row, no credit tracking — the feature is fully absent for
# those visitors, not just bypassed. Accepts false/0/off/no; anything else (or
# unset) means enabled. Takes effect on restart.
# Country comes from the same ip-api lookup used for pricing; an unresolved
# country counts as international.
MONETIZATION_ENABLED_INDIA=true
MONETIZATION_ENABLED_INTERNATIONAL=true

# --- Monetization: anonymous session + free-roast limits ---
SESSION_COOKIE_NAME=roast_session
SESSION_COOKIE_MAX_AGE_DAYS=7
# Keep "lax" while the site and API share a registrable domain
# (instaroasts.com + api.instaroasts.com, or localhost:5173 + localhost:8080).
# If the API is served from an unrelated domain — a dev tunnel, testing from a
# phone — every call is cross-site and Lax cookies are silently never sent, so
# each request looks like a new visitor. That case needs:
#   SESSION_COOKIE_SAMESITE=none
#   SESSION_COOKIE_SECURE=true      (browsers reject SameSite=None without it)
# and the tunnel origin added to ALLOWED_ORIGIN.
SESSION_COOKIE_SAMESITE=lax
# Defaults to true only when NODE_ENV=production; set explicitly to override.
# SESSION_COOKIE_SECURE=false
# Free roasts per browser session (per roast_session cookie)
FREE_ROAST_LIMIT=2
# Soft cap on free roasts summed across all sessions sharing one IP — blunts
# incognito/cookie-clearing abuse without hard-blocking anyone.
IP_FREE_ROAST_LIMIT=5
# Timeout for the ip-api.com country lookup; on failure pricing falls back to USD
GEOLOCATION_TIMEOUT_MS=2000
# In-memory IP->country cache. Keeps the per-request gating check off ip-api,
# whose free tier allows only ~45 requests/minute.
GEOLOCATION_CACHE_MINUTES=60
GEOLOCATION_CACHE_MAX=5000
# Local dev only: localhost has no geolocatable IP, so pricing always falls to
# the international (USD) bracket. Set this to see the INR paywall locally.
# Only applied to private/loopback IPs, so it can never mis-price real visitors.
# DEV_FORCE_COUNTRY=IN

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate from KEY_SECRET — set when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
PAID_CREDITS_PER_PURCHASE=2

# Dual pricing by visitor country. Amounts are in the smallest currency unit
# (paise / cents). The USD leg requires International Payments to be enabled on
# the Razorpay account — confirm in the dashboard before going live.
INDIA_COUNTRY_CODE=IN
PRICE_AMOUNT_INR=10000
PRICE_CURRENCY_INR=INR
PRICE_AMOUNT_USD=199
PRICE_CURRENCY_USD=USD

# Roast job queue (async processing, see backEnd/routes/roastStream.js)
# TTL of the per-job SSE auth token minted at enqueue time
STREAM_TOKEN_TTL=10m
# Per-instance cap on roast jobs actively processed at once
MAX_CONCURRENT_ROAST_JOBS=5

# LLM provider fallback order (comma-separated, tried left-to-right)
# Valid values: groq, gemini, gpt-4o-mini, deepseek
LLM_PROVIDER_ORDER=groq,gemini,gpt-4o-mini,deepseek

# Groq (Llama 4 Scout — vision + text, fastest)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Reasoning models only (qwen3, deepseek-r1, gpt-oss). "hidden" keeps the
# chain-of-thought out of the response. Leave empty for non-reasoning models —
# Groq rejects the param otherwise.
GROQ_REASONING_FORMAT=

# Gemini (vision + text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (vision + text)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (text only — skipped for vision requests)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Bucket for rendered link-preview (Open Graph) card images. Private: the
# images are streamed by /api/v1/og-image, so no public IAM grant is needed.
MEDIA_BUCKET_NAME=instaroasts-media

# Public origin of this API, used to build absolute og:image URLs. Falls back to
# the request host, which is wrong behind a proxy that rewrites it.
PUBLIC_API_ORIGIN=
